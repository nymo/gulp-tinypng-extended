{
  "name": "gulp-tinypng-extended",
  "version": "4.0.0-alpha.0",
  "description": "TinyPNG API wrapper for compressing PNG & JPG images",
  "main": "index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "index.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nymo/gulp-tinypng-extended.git"
  },
  "bugs": {
    "url": "https://github.com/nymo/gulp-tinypng-extended/issues"
  },
  "homepage": "https://github.com/nymo/gulp-tinypng-extended#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "lint": "eslint .",
    "test": "vitest run",
    "pretest": "npm run build",
    "coverage": "vitest run --coverage --coverage.include=dist/**/*.js --coverage.exclude=test/** --coverage.reporter=text --coverage.reporter=lcov --coverage.reporter=json-summary",
    "precoverage": "npm run build"
  },
  "author": {
    "name": "Gregor Panek",
    "email": "gp@gregorpanek.de",
    "url": "https://github.com/nymo"
  },
  "keywords": [
    "gulpplugin",
    "tinypng",
    "image",
    "img",
    "picture",
    "photo",
    "minify",
    "minifier",
    "compress",
    "png"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "ansi-colors": "^3.2.4",
    "fancy-log": "^1.3.3",
    "gulp-plumber": "^1.1.0",
    "minimatch": "^5.1.9",
    "minimist": "^1.2.0",
    "plugin-error": "^1.0.1",
    "through2": "^3.0.0",
    "through2-concurrent": "^2.0.0",
    "tinify": "^1.8.3",
    "vinyl": "^2.2.0",
    "yargs-parser": "^13.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "gulp": "^5.0.1",
    "nock": "^13.5.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
